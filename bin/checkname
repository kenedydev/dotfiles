#!/usr/bin/env python3
import argparse
import os
import re
import string
import sys
import unicodedata
from pathlib import Path

# Renaming these breaks the tools that look them up by this exact case.
STANDARD_NAMES = {
    "CMakeLists.txt",
    "LICENSE",
    "README",
    "README.md",
    "Dockerfile",
    "docker-compose.yml",
    "Makefile",
}

# A plain suffix search stops at the last dot and would leave the ".tar" behind.
COMPOUND_EXTENSIONS = (".tar.gz", ".tar.xz", ".tar.bz2", ".tar.zst", ".tar.lz")

# What Path.name reports for a path naming no entry of its own: "." and "..", and
# "" for the root and for a bare ".".
NAMELESS_COMPONENTS = {"", ".", ".."}

SEPARATOR = "_"
PATTERN_INVALID_CHARACTERS = r"[^a-z0-9]+"
PATTERN_EXTENSION = r"[a-zA-Z0-9]+"
TRAILING_NOISE = string.whitespace + "."

SCRIPT_NAME = Path(__file__).name


def split_name(path):
    prefix = "." if path.name.startswith(".") else ""
    # Trailing dots and whitespace go first, or the search below finds a blank
    # segment after the last dot instead of the real extension.
    name = path.name[len(prefix) :].rstrip(TRAILING_NOISE)

    # The symlink test comes first, as is_dir would answer for the target.
    if not path.is_symlink() and path.is_dir():
        return prefix, name, ""

    lowered = name.lower()
    for extension in COMPOUND_EXTENSIONS:
        if lowered.endswith(extension) and len(lowered) > len(extension):
            return prefix, name[: -len(extension)], name[-len(extension) :]

    stem, dot, extension = name.rpartition(".")
    candidate = extension.lstrip()
    if stem and re.fullmatch(PATTERN_EXTENSION, candidate):
        return prefix, stem, dot + candidate
    return prefix, name, ""


def normalize_string(text):
    decomposed = unicodedata.normalize("NFD", text)
    # Only combining marks are dropped. A character with no ASCII form of its own
    # (Ω, ß, kanji) stays in and becomes a separator, as dropping it would join
    # its neighbours instead.
    unaccented = "".join(char for char in decomposed if not unicodedata.combining(char))
    normalized = re.sub(PATTERN_INVALID_CHARACTERS, SEPARATOR, unaccented.lower())
    return normalized.strip(SEPARATOR)


def target_name(path):
    prefix, stem, extension = split_name(path)
    stem = normalize_string(stem)
    return prefix + stem + extension.lower() if stem else ""


def is_valid_name(path):
    # A path ending in "." or ".." holds no name to judge, and the normalizer
    # would read the dots as a name that folds away to nothing.
    if path.name in NAMELESS_COMPONENTS:
        return True
    return path.name in STANDARD_NAMES or target_name(path) == path.name


def normalize_name(path, args, claimed):
    new_name = target_name(path)
    if not new_name:
        print(f"{SCRIPT_NAME}: skipping (name becomes empty): {path}")
        return

    new_path = path.parent / new_name
    if new_path == path:
        return

    # Both collision tests come before the dry run reports, or a run that would
    # be refused is announced as a rename that is going to happen.
    #
    # claimed catches two paths normalizing to the same name even before the
    # first rename touches the disk. Keyed on the absolute path, or the same name
    # reached through two spellings would count as two.
    if os.path.abspath(new_path) in claimed:
        print(f"{SCRIPT_NAME}: error: {new_path} is already taken by another rename, skipping")
        return

    # lexists, or a broken symlink sitting on the target name would read as free
    # and be overwritten by the rename below.
    if os.path.lexists(new_path):
        print(f"{SCRIPT_NAME}: error: {new_path} already exists, skipping")
        return

    if args.dry_run:
        print(f"{SCRIPT_NAME}: dry run: {path} -> {new_path}")
        claimed.add(os.path.abspath(new_path))
        return

    try:
        path.rename(new_path)
        claimed.add(os.path.abspath(new_path))
        if args.verbose:
            print(f"{SCRIPT_NAME}: renamed: {path} -> {new_path}")
    except OSError as error:
        print(f"{SCRIPT_NAME}: error renaming {path}: {error}")


def main():
    parser = argparse.ArgumentParser(
        prog=SCRIPT_NAME,
        description="Report or normalize file and directory names to lowercase "
        "snake_case. Without -n it only lists the names that do not match.",
    )
    parser.add_argument("paths", nargs="+", type=Path, help="files or directories to check")
    parser.add_argument(
        "-n", "--normalize-name", dest="normalize", action="store_true", help="rename instead of only reporting"
    )
    parser.add_argument(
        "-d",
        "--dry-run",
        action="store_true",
        help="with -n, show renames without applying them, reporting the ones a collision would block",
    )
    parser.add_argument("-v", "--verbose", action="store_true", help="print each rename as it happens")
    # Intermixed, so a flag is accepted anywhere among the paths.
    args = parser.parse_intermixed_args()

    # lexists, so a broken symlink counts as a path of its own rather than as a
    # missing one, and gets its name checked like any other entry.
    for missing in (path for path in args.paths if not os.path.lexists(path)):
        print(f"{SCRIPT_NAME}: error: path does not exist: {missing}")

    paths = [path for path in args.paths if os.path.lexists(path)]
    if not paths:
        sys.exit(1)

    # Deepest first, so renaming a directory never invalidates a path still
    # queued below it.
    paths.sort(key=lambda path: len(path.absolute().parts), reverse=True)

    claimed = set()
    for path in paths:
        if is_valid_name(path):
            continue
        if args.normalize:
            normalize_name(path, args, claimed)
        else:
            print(path)


if __name__ == "__main__":
    main()
