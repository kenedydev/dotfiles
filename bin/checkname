#!/usr/bin/env python3
import argparse
import os
import re
import stat
import string
import sys
import unicodedata
from pathlib import Path

# A search from the last dot would leave the ".tar" behind.
COMPOUND_EXTENSIONS = (".tar.gz", ".tar.xz", ".tar.bz2", ".tar.zst", ".tar.lz")

# What Path.name reports for a path that names no entry of its own.
NAMELESS_COMPONENTS = {"", ".", ".."}

SEPARATOR = "_"
PATTERN_INVALID_CHARACTERS = r"[^a-z0-9]+"
PATTERN_EXTENSION = r"[a-zA-Z0-9]+"
PATTERN_UNPRINTABLE = r"[\x00-\x1f\x7f-\x9f\ud800-\udfff]"
TRAILING_NOISE = string.whitespace + "."

SCRIPT_NAME = Path(__file__).name

# Ordered by severity: the run exits with the worst one reached.
EXIT_OK = 0
EXIT_FINDINGS = 1
EXIT_ERROR = 2


def escape(text):
    return re.sub(PATTERN_UNPRINTABLE, _escaped_character, str(text))


def _escaped_character(match):
    character = match.group()
    if "\udc80" <= character <= "\udcff":
        return f"\\x{ord(character) - 0xDC00:02x}"
    return repr(character)[1:-1]


def _delimited(*paths):
    return b"".join(os.fsencode(path) + b"\0" for path in paths)


def _sentence(label, path, new_path):
    return f"{SCRIPT_NAME}: {label}: {escape(path)} -> {escape(new_path)}\n"


class Report:
    def __init__(self, zero=False):
        self.status = EXIT_OK
        self.zero = zero
        self.closed = set()

    def name(self, path):
        text = _delimited(path) if self.zero else escape(path) + "\n"
        self._write(sys.stdout, text)
        self.status = max(self.status, EXIT_FINDINGS)

    def planned(self, path, new_path):
        text = _delimited(path, new_path) if self.zero else _sentence("dry run", path, new_path)
        self._write(sys.stdout, text)
        self.status = max(self.status, EXIT_FINDINGS)

    def renamed(self, path, new_path):
        self._write(sys.stdout, _sentence("renamed", path, new_path))

    def error(self, message):
        self._write(sys.stderr, f"{SCRIPT_NAME}: error: {escape(message)}\n")
        self.status = max(self.status, EXIT_ERROR)

    def _write(self, stream, text):
        if stream in self.closed:
            return
        try:
            if isinstance(text, bytes):
                stream.flush()
                stream.buffer.write(text)
            else:
                stream.write(text)
        except BrokenPipeError:
            self.closed.add(stream)


class Entry:
    def __init__(self, path):
        status = os.lstat(path)

        self.path = path
        self.name = path.name
        self.directory = os.path.realpath(path.parent)
        self.absolute = os.path.join(self.directory, self.name)
        self.is_directory = stat.S_ISDIR(status.st_mode)
        self.target = self._target_name()
        self.new_path = path.parent / self.target
        self.new_absolute = os.path.join(self.directory, self.target)

    @property
    def depth(self):
        return self.absolute.count(os.sep)

    @property
    def matches_convention(self):
        return self.target == self.name

    def _target_name(self):
        if self.name in NAMELESS_COMPONENTS:
            return self.name

        prefix, stem, extension = self._split_name()
        stem = self._normalize(stem)
        return prefix + stem + extension.lower() if stem else ""

    def _split_name(self):
        prefix = "." if self.name.startswith(".") else ""
        name = self.name[len(prefix) :].rstrip(TRAILING_NOISE)

        if self.is_directory:
            return prefix, name, ""

        lowered = name.lower()
        for extension in COMPOUND_EXTENSIONS:
            if lowered.endswith(extension) and len(lowered) > len(extension):
                return prefix, name[: -len(extension)], name[-len(extension) :]

        stem, dot, extension = name.rpartition(".")
        candidate = extension.lstrip()
        if stem and re.fullmatch(PATTERN_EXTENSION, candidate):
            return prefix, stem, dot + candidate
        return prefix, name, ""

    @staticmethod
    def _normalize(text):
        decomposed = unicodedata.normalize("NFKD", text)
        unaccented = "".join(char for char in decomposed if not unicodedata.combining(char))
        normalized = re.sub(PATTERN_INVALID_CHARACTERS, SEPARATOR, unaccented.lower())
        return normalized.strip(SEPARATOR)


class Checker:
    def __init__(self, args, report):
        self.args = args
        self.report = report
        self.claimed = set()

    def run(self, paths):
        for entry in self._entries(paths):
            if entry.matches_convention:
                continue
            if self.args.normalize:
                self._normalize_name(entry)
            else:
                self.report.name(entry.path)

    def _entries(self, paths):
        entries = []
        seen = set()
        for path in paths:
            try:
                entry = Entry(path)
            except OSError as error:
                self.report.error(f"cannot check {path}: {error.strerror.lower()}")
                continue

            if entry.absolute in seen:
                continue
            seen.add(entry.absolute)
            entries.append(entry)

        entries.sort(key=lambda entry: entry.depth, reverse=True)
        return entries

    def _normalize_name(self, entry):
        if not entry.target:
            self.report.error(f"cannot rename {entry.path}: it normalizes to an empty name")
            return

        new_path = entry.new_path

        if entry.new_absolute in self.claimed:
            self.report.error(f"cannot rename {entry.path} to {new_path}: another rename already claimed that name")
            return

        if os.path.lexists(new_path):
            self.report.error(f"cannot rename {entry.path} to {new_path}: it already exists")
            return

        if self.args.dry_run:
            self.report.planned(entry.path, new_path)
        else:
            try:
                entry.path.rename(new_path)
            except OSError as error:
                self.report.error(f"cannot rename {entry.path}: {error}")
                return
            if self.args.verbose:
                self.report.renamed(entry.path, new_path)

        self.claimed.add(entry.new_absolute)


def _writable(stream):
    return stream if stream is not None else open(os.devnull, "w")


def _discard_unwritable(stream):
    try:
        stream.flush()
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), stream.fileno())


def _is_option(argument, names, letters):
    if argument.startswith("--"):
        return len(argument) > 2 and any(name.startswith(argument) for name in names)
    return len(argument) > 1 and argument.startswith("-") and set(argument[1:]) <= letters


# Only a known option opens the line, and only a "--" closes it, so a name a
# glob turned into a flag stays a name and the directory being checked cannot
# ask for a rename.
def command_line(arguments, options):
    if arguments in (["-h"], ["--help"]):
        return arguments

    names = {name for action in options for name in action.option_strings}
    letters = {name[1:] for name in names if not name.startswith("--")}

    index = 0
    while index < len(arguments) and _is_option(arguments[index], names, letters):
        index += 1

    if index < len(arguments) and arguments[index] == "--":
        return arguments
    return ["--"] + arguments


def main():
    sys.stdout = _writable(sys.stdout)
    sys.stderr = _writable(sys.stderr)
    sys.stdout.reconfigure(errors="backslashreplace")
    sys.stderr.reconfigure(errors="backslashreplace")

    parser = argparse.ArgumentParser(
        prog=SCRIPT_NAME,
        usage=f"{SCRIPT_NAME} path [path ...]\n       {SCRIPT_NAME} [-n] [-d] [-v] [-z] -- path [path ...]",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Report or normalize file and directory names to lowercase snake_case.\nOnly the paths given are checked, never what a directory holds.",
        epilog="the convention:\n"
        '  name       [a-z0-9] words joined by "_"; an accent folds to its base\n'
        "             letter, a compatibility form to its plain characters, and\n"
        "             every other invalid character to a separator; a leading dot\n"
        "             is kept, and trailing dots and whitespace are dropped\n"
        "  extension  ASCII letters and digits only, lowercased; surrounding\n"
        "             whitespace is trimmed, but a suffix needing any other change\n"
        '             is not an extension and is normalized into the name; ".tar.gz"\n'
        "             and its kin stay whole, and a directory has no extension\n"
        "\n"
        "arguments:\n"
        '  an option is read only while it opens the command line, and a "--" closes\n'
        '  the options, as in "' + SCRIPT_NAME + ' -n -- *"; every other argument is a path,\n'
        '  so a name a glob turned into a flag, or into a later "--", is still a name\n'
        "\n"
        "  a path given twice is checked once, and the deepest comes first, so a\n"
        "  child is renamed before the parent whose name still leads to it\n"
        "\n"
        "output:\n"
        "  the report goes to stdout and every error to stderr, so stdout can be\n"
        "  piped in any mode; a control character or a byte that is not valid UTF-8\n"
        "  is escaped in a reported name, unless -z asks for the raw bytes\n"
        "\n"
        "exit status:\n"
        "  0  every name checked already follows the convention, or was renamed to it\n"
        "  1  a name is off the convention and was only reported, not fixed\n"
        "  2  a path could not be read, or a name could not be fixed",
    )
    parser.add_argument("paths", metavar="path", nargs="+", type=Path, help="file or directory to check")
    options = [
        parser.add_argument("-n", "--normalize-name", dest="normalize", action="store_true", help="rename instead of reporting; silent unless -v"),
        parser.add_argument("-d", "--dry-run", action="store_true", help="show the renames without applying them; implies -n"),
        parser.add_argument("-v", "--verbose", action="store_true", help="print each rename as it happens; a dry run shows them anyway"),
        parser.add_argument("-z", "--zero", action="store_true", help="end each reported name with a NUL instead of a newline, for xargs -0; a dry run reports the old name then the new one"),
    ]

    args = parser.parse_args(command_line(sys.argv[1:], options))

    # A dry run only has something to show if it is a dry run of the renames.
    args.normalize = args.normalize or args.dry_run

    report = Report(args.zero)
    Checker(args, report).run(args.paths)

    _discard_unwritable(sys.stdout)
    _discard_unwritable(sys.stderr)
    sys.exit(report.status)


if __name__ == "__main__":
    main()
