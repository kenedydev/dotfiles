#!/usr/bin/env python3
import argparse
import os
import re
import string
import sys
import unicodedata
from pathlib import Path

# Tools look these up by this exact case.
STANDARD_NAMES = {
    "CMakeLists.txt",
    "LICENSE",
    "README",
    "README.md",
    "Dockerfile",
    "docker-compose.yml",
    "Makefile",
}

# A search from the last dot would leave the ".tar" behind.
COMPOUND_EXTENSIONS = (".tar.gz", ".tar.xz", ".tar.bz2", ".tar.zst", ".tar.lz")

# What Path.name reports for a path that names no entry of its own.
NAMELESS_COMPONENTS = {"", ".", ".."}

SEPARATOR = "_"
PATTERN_INVALID_CHARACTERS = r"[^a-z0-9]+"
PATTERN_EXTENSION = r"[a-zA-Z0-9]+"
TRAILING_NOISE = string.whitespace + "."

SCRIPT_NAME = Path(__file__).name

# Ordered by severity: the run exits with the worst one reached.
EXIT_OK = 0
EXIT_FINDINGS = 1
EXIT_ERROR = 2


class Report:
    def __init__(self):
        self.status = EXIT_OK

    # Names on stdout, diagnostics on stderr, so the report can be piped.
    def name(self, path):
        print(path)
        self.status = max(self.status, EXIT_FINDINGS)

    # An announced rename leaves the name off the convention, like a reported one.
    def planned(self, path, new_path):
        print(f"{SCRIPT_NAME}: dry run: {path} -> {new_path}")
        self.status = max(self.status, EXIT_FINDINGS)

    def renamed(self, path, new_path):
        print(f"{SCRIPT_NAME}: renamed: {path} -> {new_path}")

    def error(self, message):
        print(f"{SCRIPT_NAME}: error: {message}", file=sys.stderr)
        self.status = max(self.status, EXIT_ERROR)


def split_name(path):
    prefix = "." if path.name.startswith(".") else ""
    # Stripped first, or the search below finds a blank segment after the last
    # dot instead of the extension.
    name = path.name[len(prefix) :].rstrip(TRAILING_NOISE)

    # is_dir answers for the target, so the symlink test comes first.
    if not path.is_symlink() and path.is_dir():
        return prefix, name, ""

    lowered = name.lower()
    for extension in COMPOUND_EXTENSIONS:
        if lowered.endswith(extension) and len(lowered) > len(extension):
            return prefix, name[: -len(extension)], name[-len(extension) :]

    stem, dot, extension = name.rpartition(".")
    candidate = extension.lstrip()
    if stem and re.fullmatch(PATTERN_EXTENSION, candidate):
        return prefix, stem, dot + candidate
    return prefix, name, ""


def normalize_string(text):
    decomposed = unicodedata.normalize("NFD", text)
    # Only combining marks are dropped. A character with no ASCII form (Ω, ß,
    # kanji) becomes a separator, as dropping it would join its neighbours.
    unaccented = "".join(char for char in decomposed if not unicodedata.combining(char))
    normalized = re.sub(PATTERN_INVALID_CHARACTERS, SEPARATOR, unaccented.lower())
    return normalized.strip(SEPARATOR)


def target_name(path):
    prefix, stem, extension = split_name(path)
    stem = normalize_string(stem)
    return prefix + stem + extension.lower() if stem else ""


def is_valid_name(path):
    # No name to judge, and the normalizer would fold the dots away to nothing.
    if path.name in NAMELESS_COMPONENTS:
        return True
    return path.name in STANDARD_NAMES or target_name(path) == path.name


def normalize_name(path, args, claimed, report):
    new_name = target_name(path)
    if not new_name:
        report.error(f"{path} normalizes to an empty name, skipping")
        return

    new_path = path.parent / new_name
    if new_path == path:
        return

    # Both collision tests come before the dry run report, or a refused rename is
    # announced as one that will happen.
    #
    # claimed catches two paths normalizing to the same name before any rename
    # reaches the disk. Keyed on the absolute path, or the same name reached
    # through two spellings would count as two.
    if os.path.abspath(new_path) in claimed:
        report.error(f"{new_path} is already taken by another rename, skipping")
        return

    # lexists, or a broken symlink on the target name reads as free and gets
    # overwritten by the rename below.
    if os.path.lexists(new_path):
        report.error(f"{new_path} already exists, skipping")
        return

    if args.dry_run:
        report.planned(path, new_path)
        claimed.add(os.path.abspath(new_path))
        return

    try:
        path.rename(new_path)
    except OSError as error:
        report.error(f"cannot rename {path}: {error}")
        return

    claimed.add(os.path.abspath(new_path))
    if args.verbose:
        report.renamed(path, new_path)


def main():
    parser = argparse.ArgumentParser(
        prog=SCRIPT_NAME,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Report or normalize file and directory names to lowercase snake_case.\n"
        "Without -n it only lists the names that do not match.",
        epilog="the convention:\n"
        '  name       [a-z0-9] words joined by "_"; accents fold to their base letter\n'
        "             and every other invalid character becomes a separator\n"
        "  extension  ASCII letters and digits only, lowercased; surrounding whitespace\n"
        "             is trimmed, but a suffix needing any other change is not an\n"
        "             extension and is normalized as part of the name\n"
        "\n"
        "exit status:\n"
        "  0  every name checked already follows the convention, or was renamed to it\n"
        "  1  a name is off the convention and was only reported, not fixed\n"
        "  2  a path does not exist, or a name could not be fixed",
    )
    parser.add_argument("paths", metavar="path", nargs="+", type=Path, help="file or directory to check")
    parser.add_argument(
        "-n", "--normalize-name", dest="normalize", action="store_true", help="rename instead of only reporting"
    )
    parser.add_argument(
        "-d",
        "--dry-run",
        action="store_true",
        help="show the renames without applying them, including the ones a collision would block",
    )
    parser.add_argument("-v", "--verbose", action="store_true", help="print each rename as it happens")
    # Intermixed, so a flag is accepted anywhere among the paths.
    args = parser.parse_intermixed_args()

    # A dry run only has something to show if it is a dry run of the renames.
    args.normalize = args.normalize or args.dry_run

    report = Report()

    # lexists, so a broken symlink counts as a path of its own, not a missing one.
    for missing in (path for path in args.paths if not os.path.lexists(path)):
        report.error(f"path does not exist: {missing}")

    # Deepest first, so renaming a directory never invalidates a queued path
    # below it.
    paths = [path for path in args.paths if os.path.lexists(path)]
    paths.sort(key=lambda path: len(path.absolute().parts), reverse=True)

    claimed = set()
    for path in paths:
        if is_valid_name(path):
            continue
        if args.normalize:
            normalize_name(path, args, claimed, report)
        else:
            report.name(path)

    sys.exit(report.status)


if __name__ == "__main__":
    main()
